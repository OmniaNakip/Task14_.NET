@model Movie_Management_System.Models.Movie

@{
    ViewData["Title"] = "Edit Movie";
}

<h1>Edit Movie</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <!-- Name -->
            <div class="form-group mb-3">
                <label asp-for="Name"
                       class="control-label"></label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <!-- Description -->
            <div class="form-group mb-3">
                <label asp-for="Description"
                       class="control-label"></label>

                <textarea asp-for="Description"
                          class="form-control"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <!-- Price -->
            <div class="form-group mb-3">
                <label asp-for="Price"
                       class="control-label"></label>

                <input asp-for="Price"
                       type="number"
                       step="0.01"
                       class="form-control" />

                <span asp-validation-for="Price"
                      class="text-danger"></span>
            </div>

            <!-- Status -->
            <div class="form-group mb-3">
                <label asp-for="Status"
                       class="control-label"></label>

                <select asp-for="Status"
                        class="form-control">

                    <option value="">-- Select Status --</option>
                    <option value="Coming Soon">Coming Soon</option>
                    <option value="Available">Available</option>
                    <option value="Expired">Expired</option>

                </select>

                <span asp-validation-for="Status"
                      class="text-danger"></span>
            </div>

            <!-- Date -->
            <div class="form-group mb-3">
                <label asp-for="DateTime"
                       class="control-label"></label>

                <input asp-for="DateTime"
                       type="datetime-local"
                       class="form-control" />

                <span asp-validation-for="DateTime"
                      class="text-danger"></span>
            </div>

            <!-- Main Image -->
            <div class="form-group mb-3">

                <label asp-for="MainImg"
                       class="control-label"></label>

                <input asp-for="MainImg"
                       class="form-control" />

                <span asp-validation-for="MainImg"
                      class="text-danger"></span>

            </div>

            <!-- Sub Images -->
            <div class="form-group mb-3">

                <label class="control-label">
                    Sub Images
                </label>

                <input name="SubImages"
                       class="form-control"
                       placeholder="image1.jpg,image2.jpg" />

            </div>

            <!-- Category -->
            <div class="form-group mb-3">

                <label class="control-label">
                    Category
                </label>

                <select asp-for="CategoryId"
                        class="form-control">

                    <option value="">
                        -- Select Category --
                    </option>

                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.Id">
                            @category.Name
                        </option>
                    }

                </select>

                <span asp-validation-for="CategoryId"
                      class="text-danger"></span>

            </div>

            <!-- Cinema -->
            <div class="form-group mb-3">

                <label class="control-label">
                    Cinema
                </label>

                <select asp-for="CinemaId"
                        class="form-control">

                    <option value="">
                        -- Select Cinema --
                    </option>

                    @foreach (var cinema in ViewBag.Cinemas)
                    {
                        <option value="@cinema.Id">
                            @cinema.Name
                        </option>
                    }

                </select>

                <span asp-validation-for="CinemaId"
                      class="text-danger"></span>

            </div>

            <!-- Actors -->
            <div class="form-group mb-3">

                <label class="control-label">
                    Actors
                </label>

                <select name="actorIds"
                        class="form-control"
                        multiple>

                    @foreach (var actor in ViewBag.Actors)
                    {
                        <option value="@actor.Id">
                            @actor.Name
                        </option>
                    }

                </select>

                <small class="text-muted">
                    Hold Ctrl to select multiple actors.
                </small>

            </div>

            <!-- Buttons -->
            <div class="form-group mt-4">

                <input type="submit"
                       value="Save"
                       class="btn btn-primary" />

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back to List
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}