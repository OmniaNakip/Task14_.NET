@model Movie_Management_System.Models.Movie

@{
    ViewData["Title"] = "Movie Details";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Movie Details</h2>
            <p class="text-muted mb-0">
                View complete movie information
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                <i class="fas fa-edit me-2"></i>
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-light">
                Back
            </a>

        </div>

    </div>


    <div class="card border-0 shadow-sm rounded-3">

        <div class="card-body p-4">

            <div class="row g-4">

                <!-- Image -->
                <div class="col-lg-3 text-center">

                    @if (!string.IsNullOrEmpty(Model.MainImg))
                    {
                        <img src="@Model.MainImg"
                             alt="@Model.Name"
                             class="img-fluid rounded-3 shadow-sm"
                             style="max-height:350px; object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-light rounded-3 d-flex align-items-center justify-content-center"
                             style="height:300px;">
                            <i class="fas fa-film fa-4x text-muted"></i>
                        </div>
                    }

                </div>


                <!-- Information -->
                <div class="col-lg-9">

                    <h2 class="fw-bold mb-2">
                        @Model.Name
                    </h2>

                    <p class="text-muted mb-4">
                        @Model.Description
                    </p>


                    <div class="row g-3">

                        <div class="col-md-6">
                            <div class="bg-light rounded-3 p-3">
                                <small class="text-muted">
                                    Price
                                </small>
                                <h5 class="fw-bold mb-0 mt-1">
                                    @Model.Price
                                </h5>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="bg-light rounded-3 p-3">
                                <small class="text-muted">
                                    Status
                                </small>
                                <h5 class="fw-bold mb-0 mt-1">
                                    @Model.Status
                                </h5>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="bg-light rounded-3 p-3">
                                <small class="text-muted">
                                    Category
                                </small>
                                <h5 class="fw-bold mb-0 mt-1">
                                    @Model.Category?.Name
                                </h5>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="bg-light rounded-3 p-3">
                                <small class="text-muted">
                                    Cinema
                                </small>
                                <h5 class="fw-bold mb-0 mt-1">
                                    @Model.Cinema?.Name
                                </h5>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="bg-light rounded-3 p-3">
                                <small class="text-muted">
                                    Date
                                </small>
                                <h5 class="fw-bold mb-0 mt-1">
                                    @Model.DateTime.ToString("dd MMM yyyy")
                                </h5>
                            </div>
                        </div>

                    </div>


                    <!-- Actors -->
                    <div class="mt-4">

                        <h5 class="fw-bold mb-3">
                            Actors
                        </h5>

                        @if (Model.Actors != null && Model.Actors.Any())
                        {
                            <div class="d-flex flex-wrap gap-2">

                                @foreach (var actor in Model.Actors)
                                {
                                    <span class="badge bg-primary-subtle text-primary px-3 py-2">
                                        @actor.Name
                                    </span>
                                }

                            </div>
                        }
                        else
                        {
                            <span class="text-muted">
                                No actors assigned.
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>