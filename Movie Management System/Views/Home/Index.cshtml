@model Movie_Management_System.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-end align-items-center p-3">

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <span class="me-3">
            Welcome, @User.Identity.Name
        </span>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post">
            <button type="submit" class="btn btn-danger">
                Logout
            </button>
        </form>
    }
    else
    {
        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-outline-dark me-2">
            Login
        </a>

        <a asp-controller="Account"
           asp-action="Register"
           class="btn btn-primary">
            Create Account
        </a>
    }

</div>

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="mb-1 fw-bold">Dashboard</h3>
            <p class="text-muted mb-0">
                Welcome to Movie Management System
            </p>
        </div>

        <div>
            <a asp-controller="Movies"
               asp-action="Create"
               class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>
                Add Movie
            </a>
        </div>

    </div>


    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total Movies
                            </p>

                            <h3 class="mb-0 fw-bold">
                                @ViewBag.MovieCount
                            </h3>

                        </div>

                        <div class="bg-soft-primary rounded-circle p-3">
                            <i class="fas fa-film text-primary fs-4"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total Actors
                            </p>

                            <h3 class="mb-0 fw-bold">
                                @ViewBag.ActorCount
                            </h3>

                        </div>

                        <div class="bg-soft-success rounded-circle p-3">
                            <i class="fas fa-users text-success fs-4"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Cinemas
                            </p>

                            <h3 class="mb-0 fw-bold">
                                @ViewBag.CinemaCount
                            </h3>

                        </div>

                        <div class="bg-soft-warning rounded-circle p-3">
                            <i class="fas fa-building text-warning fs-4"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Categories
                            </p>

                            <h3 class="mb-0 fw-bold">
                                @ViewBag.CategoryCount
                            </h3>

                        </div>

                        <div class="bg-soft-info rounded-circle p-3">
                            <i class="fas fa-folder text-info fs-4"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


   
    <div class="row g-3 mb-4">

        <div class="col-xl-5">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="mb-1">
                        Movie Distribution
                    </h5>

                    <p class="text-muted mb-0">
                        Movies by category
                    </p>

                </div>

                <div class="card-body">

                    <div style="height:320px;">
                        <canvas id="movieDistribution"></canvas>
                    </div>

                </div>

            </div>

        </div>


        <!-- Movies By Cinema -->
        <div class="col-xl-7">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="mb-1">
                        Movies by Cinema
                    </h5>

                    <p class="text-muted mb-0">
                        Number of movies in each cinema
                    </p>

                </div>

                <div class="card-body">

                    <div style="height:320px;">
                        <canvas id="cinemaChart"></canvas>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Quick Management -->
    <div class="row g-3 mb-4">

        <div class="col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="mb-0">
                        Quick Management
                    </h5>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-6">

                            <a asp-controller="Movies"
                               asp-action="Index"
                               class="btn btn-outline-primary w-100 py-3">

                                <i class="fas fa-film d-block mb-2 fs-4"></i>

                                Movies

                            </a>

                        </div>

                        <div class="col-6">

                            <a asp-controller="Actors"
                               asp-action="Index"
                               class="btn btn-outline-success w-100 py-3">

                                <i class="fas fa-users d-block mb-2 fs-4"></i>

                                Actors

                            </a>

                        </div>

                        <div class="col-6">

                            <a asp-controller="Cinemas"
                               asp-action="Index"
                               class="btn btn-outline-warning w-100 py-3">

                                <i class="fas fa-building d-block mb-2 fs-4"></i>

                                Cinemas

                            </a>

                        </div>

                        <div class="col-6">

                            <a asp-controller="Categories"
                               asp-action="Index"
                               class="btn btn-outline-info w-100 py-3">

                                <i class="fas fa-folder d-block mb-2 fs-4"></i>

                                Categories

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex justify-content-between">

                        <h5 class="mb-0">
                            Recent Movies
                        </h5>

                        <a asp-controller="Movies"
                           asp-action="Index"
                           class="text-primary">
                            View All
                        </a>

                    </div>

                </div>

                <div class="card-body">

                    @if (ViewBag.RecentMovies != null)
                    {
                        foreach (var movie in ViewBag.RecentMovies)
                        {
                            <div class="d-flex align-items-center mb-3">

                                <div class="rounded bg-light p-3 me-3">

                                    <i class="fas fa-film text-primary"></i>

                                </div>

                                <div class="flex-grow-1">

                                    <h6 class="mb-1">
                                        @movie.Name
                                    </h6>

                                    <small class="text-muted">
                                        @movie.Category?.Name
                                    </small>

                                </div>

                                <a asp-controller="Movies"
                                   asp-action="Details"
                                   asp-route-id="@movie.Id"
                                   class="btn btn-sm btn-outline-primary">

                                    View

                                </a>

                            </div>
                        }
                    }

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

     

        const categoryLabels = [
        @foreach (var category in Model.Categories)
        {
            <text>"@category.Name",</text>
        }
        ];

        const categoryData = [
        @foreach (var category in Model.Categories)
        {
            <text>@category.Movies.Count,</text>
        }
        ];


        new Chart(
        document.getElementById('movieDistribution'),
        {
        type: 'doughnut',

        data: {
        labels: categoryLabels,

        datasets: [{
        data: categoryData
        }]
        },

        options: {

        responsive: true,

        maintainAspectRatio: false,

        plugins: {

        legend: {
        position: 'bottom'
        }

        }

        }
        }
        );


   

        const cinemaLabels = [
        @foreach (var cinema in Model.Cinemas)
        {
            <text>"@cinema.Name",</text>
        }
        ];

        const cinemaData = [
        @foreach (var cinema in Model.Cinemas)
        {
            <text>@cinema.Movies.Count,</text>
        }
        ];


        new Chart(
        document.getElementById('cinemaChart'),
        {
        type: 'bar',

        data: {
        labels: cinemaLabels,

        datasets: [{
        label: 'Movies',
        data: cinemaData
        }]
        },

        options: {

        responsive: true,

        maintainAspectRatio: false,

        scales: {
        y: {
        beginAtZero: true
        }
        },

        plugins: {
        legend: {
        display: false
        }
        }

        }

        }
        );

    </script>
}