<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Movie Management System</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com" />

    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,500,600,700%7cPoppins:300,400,500,600,700,800,900&display=swap"
          rel="stylesheet" />

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Theme -->
    <link rel="stylesheet" href="~/assets/css/theme.min.css" />

    <link rel="stylesheet" href="~/assets/css/user.min.css" />

    <style>

            body {
                font-family: "Poppins", sans-serif;
                background-color: #f5f7fa;
            }

            .navbar-vertical {
                width: 250px;
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 1000;
                background: #ffffff;
                border-right: 1px solid #e9ecef;
                overflow-y: auto;
            }

            .main-content {
                margin-left: 250px;
                min-height: 100vh;
            }

            .navbar-top {
                height: 70px;
                background: white;
                border-bottom: 1px solid #e9ecef;
                position: sticky;
                top: 0;
                z-index: 999;
            }

            .sidebar-logo {
                height: 70px;
                display: flex;
                align-items: center;
                padding: 0 25px;
                border-bottom: 1px solid #e9ecef;
            }

                .sidebar-logo h4 {
                    margin: 0;
                    font-weight: 700;
                    color: #2c7be5;
                }

            .sidebar-menu {
                padding: 20px 15px;
            }

            .sidebar-title {
                font-size: 11px;
                text-transform: uppercase;
                color: #9da9bb;
                font-weight: 600;
                margin: 15px 10px 8px;
            }

            .sidebar-menu a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 11px 15px;
                margin-bottom: 5px;
                border-radius: 8px;
                color: #5e6e82;
                text-decoration: none;
                transition: 0.2s;
            }

                .sidebar-menu a:hover {
                    background: #edf2f9;
                    color: #2c7be5;
                }

                .sidebar-menu a.active {
                    background: #2c7be5;
                    color: white;
                }

            .sidebar-menu i {
                width: 20px;
                text-align: center;
            }

            .content-wrapper {
                padding: 30px;
            }

            .card {
                border-radius: 10px;
            }

            @@media (max-width: 991px) {

                .navbar-vertical {
                    transform: translateX(-250px);
                    transition: 0.3s;
                }

                    .navbar-vertical.show {
                        transform: translateX(0);
                    }

                .main-content {
                    margin-left: 0;
                }

                .content-wrapper {
                    padding: 20px;
                }
            }

    </style>

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <!-- ================= SIDEBAR ================= -->

    <nav class="navbar-vertical">

        <div class="sidebar-logo">

            <h4>
                <i class="fas fa-film me-2"></i>
                Movie System
            </h4>

        </div>


        <div class="sidebar-menu">

            <div class="sidebar-title">
                Main
            </div>

            <a asp-controller="Home"
               asp-action="Index"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">

                <i class="fas fa-chart-pie"></i>

                <span>Dashboard</span>

            </a>


            <div class="sidebar-title">
                Management
            </div>


            <a asp-area="Admin"
                asp-controller="Movies"
               asp-action="Index"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Movies" ? "active" : "")">

                <i class="fas fa-film"></i>

                <span>Movies</span>

            </a>


            <a asp-area="Admin"
                asp-controller="Actors"
               asp-action="Index"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Actors" ? "active" : "")">

                <i class="fas fa-users"></i>

                <span>Actors</span>

            </a>


            <a asp-area="Admin"
                asp-controller="Cinemas"
               asp-action="Index"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Cinemas" ? "active" : "")">

                <i class="fas fa-building"></i>

                <span>Cinemas</span>

            </a>


            <a asp-area="Admin"
                asp-controller="Categories"
               asp-action="Index"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")">

                <i class="fas fa-folder"></i>

                <span>Categories</span>

            </a>


            <div class="sidebar-title">
                Quick Add
            </div>


            <a asp-area="Admin"
                asp-controller="Movies"
               asp-action="Create">

                <i class="fas fa-plus"></i>

                <span>Add Movie</span>

            </a>


            <a asp-area="Admin"
                asp-controller="Actors"
               asp-action="Create">

                <i class="fas fa-user-plus"></i>

                <span>Add Actor</span>

            </a>


            <a asp-area="Admin"
                asp-controller="Cinemas"
               asp-action="Create">

                <i class="fas fa-building-circle-plus"></i>

                <span>Add Cinema</span>

            </a>


            <a asp-area="Admin"
                asp-controller="Categories"
               asp-action="Create">

                <i class="fas fa-folder-plus"></i>

                <span>Add Category</span>

            </a>

        </div>

    </nav>


    <!-- ================= MAIN ================= -->

    <div class="main-content">


        <!-- ================= TOP NAVBAR ================= -->

        <nav class="navbar-top d-flex align-items-center justify-content-between px-4">

            <div class="d-flex align-items-center">

                <button class="btn btn-link d-lg-none"
                        id="sidebarToggle">

                    <i class="fas fa-bars fs-5"></i>

                </button>

                <h5 class="mb-0 fw-semibold">
                    @ViewData["Title"]
                </h5>

            </div>


            <div class="d-flex align-items-center gap-3">

                <span class="text-muted">
                    Movie Management System
                </span>

                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                     style="width:40px;height:40px;">

                    <i class="fas fa-user"></i>

                </div>

            </div>

        </nav>


        <!-- ================= CONTENT ================= -->

        <main class="content-wrapper">

            @RenderBody()

        </main>


        <!-- ================= FOOTER ================= -->

        <footer class="text-center py-4 text-muted">

            <small>
                © @DateTime.Now.Year Movie Management System
            </small>

        </footer>

    </div>


    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <!-- Theme JS -->
    <script src="~/vendors/simplebar/simplebar.min.js"></script>

    <script>

        document
        .getElementById("sidebarToggle")
        ?.addEventListener("click", function () {

        document
        .querySelector(".navbar-vertical")
        .classList.toggle("show");

        });

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>